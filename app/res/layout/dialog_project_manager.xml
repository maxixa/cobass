<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Project Manager &amp; Audio Export"
            android:textColor="@color/cubase_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseProjectDialog"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="✕"
            android:backgroundTint="#3A3A3C" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E313E"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" />

    <!-- Project Name & Save Actions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROJECT NAME"
        android:textColor="@color/cubase_text_dim"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editProjectName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="#14161C"
        android:textColor="#FFFFFF"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnSaveProject"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💾 Save Project"
            android:textSize="12sp"
            android:backgroundTint="#0A84FF" />

        <Button
            android:id="@+id/btnNewProject"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="📄 New Template"
            android:textSize="12sp"
            android:backgroundTint="#3A3A3C" />
    </LinearLayout>

    <!-- Master Audio Export (WAV) -->
    <Button
        android:id="@+id/btnExportWav"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="⚡ Export Master Audio (.WAV 48kHz)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="#30D158" />

    <ProgressBar
        android:id="@+id/exportProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtExportStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="center"
        android:textColor="@color/accent_green"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Saved Projects List -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SAVED PROJECTS (.COBASS)"
        android:textColor="@color/cubase_text_dim"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="6dp"
        android:background="#14161C"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/projectListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
