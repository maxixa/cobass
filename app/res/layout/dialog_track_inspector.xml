<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtInspectorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Track Inspector"
                android:textColor="@color/cubase_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseInspector"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3A3A3C"
                android:padding="0dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E313E"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp" />

        <!-- 1. Instrument Plugin Engine Section (For Synth Tracks) -->
        <LinearLayout
            android:id="@+id/layoutInstrumentEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161822"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSTRUMENT PLUGIN ENGINE"
                android:textColor="@color/cubase_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCurrentInstrument"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cobass PolySynth (Default Engine)"
                android:textColor="@color/cubase_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnChangeSynth"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="🎹 Change Synth Plugin"
                    android:textSize="11sp"
                    android:backgroundTint="#0A84FF" />

                <Button
                    android:id="@+id/btnEditSynth"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="⚙ Edit Synth UI"
                    android:textSize="11sp"
                    android:backgroundTint="#30D158" />
            </LinearLayout>
        </LinearLayout>

        <!-- Track Name Edit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRACK NAME"
            android:textColor="@color/cubase_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTrackName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="#14161C"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- Color Palette -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TRACK COLOR"
            android:textColor="@color/cubase_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnColorBlue"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:backgroundTint="#0A84FF" />
            <Button
                android:id="@+id/btnColorOrange"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FF9F0A" />
            <Button
                android:id="@+id/btnColorGreen"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#30D158" />
            <Button
                android:id="@+id/btnColorPurple"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#BF5AF2" />
            <Button
                android:id="@+id/btnColorRed"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FF453A" />
            <Button
                android:id="@+id/btnColorCyan"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#64D2FF" />
        </LinearLayout>

        <!-- Volume Fader -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Track Volume"
                android:textColor="@color/cubase_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVolumeReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekTrackVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="80" />

        <!-- Pan Fader -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Track Pan"
                android:textColor="@color/cubase_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPanReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Center (C)"
                android:textColor="@color/cubase_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekTrackPan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="50" />

        <!-- Quick Toggles: Phase & Modular FX Rack Shortcut -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnTogglePhase"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Phase Invert (Ø)"
                android:textSize="11sp"
                android:backgroundTint="#2C2C2E" />

            <Button
                android:id="@+id/btnOpenFxRack"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:text="🎛 Modular FX Rack (8 Slots)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#0A84FF" />
        </LinearLayout>

        <!-- Track Management & Reordering -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ARRANGER MANAGEMENT"
            android:textColor="@color/cubase_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnMoveTrackUp"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="▲ Move Up"
                android:textSize="11sp"
                android:backgroundTint="#2C2C2E" />

            <Button
                android:id="@+id/btnMoveTrackDown"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="▼ Move Down"
                android:textSize="11sp"
                android:backgroundTint="#2C2C2E" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnDuplicateTrack"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="⧉ Duplicate Track"
                android:textSize="11sp"
                android:backgroundTint="#30D158" />

            <Button
                android:id="@+id/btnDeleteTrack"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🗑 Delete Track"
                android:textSize="11sp"
                android:backgroundTint="#FF453A" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
