<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:layout_marginBottom="8dp"
    android:padding="12dp">

    <!-- Track Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTrackTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYNTH"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@color/cubase_blue"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/txtTrackName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Track 1"
            android:textColor="@color/cubase_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMute"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:text="M"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSolo"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:text="S"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Controls Row: Volume & Pan Sliders -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="VOL"
            android:textColor="@color/cubase_text_dim"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80" />

        <TextView
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="PAN"
            android:textColor="@color/cubase_text_dim"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/seekPan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50" />
    </LinearLayout>

    <!-- Audition Pad / Note Trigger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnAudition"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Audition Note (C4)"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFilterToggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Filter: 3.2kHz"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
