<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Studio Mixing Console"
            android:textColor="@color/cubase_blue"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseMixer"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF453A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="8dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/stripContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="125dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#1B1D26"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MASTER"
                android:textAlignment="center"
                android:textColor="@color/cubase_red"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMasterLimiter"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:text="LIMITER ON"
                android:textSize="10sp"
                android:backgroundTint="#30D158" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <SeekBar
                    android:id="@+id/masterFader"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />

                <LinearLayout
                    android:layout_width="16dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginStart="4dp">

                    <ProgressBar
                        android:id="@+id/masterMeterL"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="7dp"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="0" />

                    <ProgressBar
                        android:id="@+id/masterMeterR"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="7dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:max="100"
                        android:progress="0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
